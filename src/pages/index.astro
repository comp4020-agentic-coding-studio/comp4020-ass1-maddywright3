---
import Layout from "../layouts/Layout.astro";
import {
  type CabinSection,
  type SeatLayoutEntry,
  PLANE_TYPES,
  buildSeatLayout,
  initialSeatSaleInfo,
  priceForFlight,
  priceForSeat,
  sectionForSeat,
} from "../scripts/price";

const plane = PLANE_TYPES[0];
const soldSet = new Set(plane.initialSoldIndices);
const startDays = 60;
const bookingWindowStartDays = 120;
const initialPrice = priceForFlight(soldSet.size, plane, startDays).price;
const seatsRemaining = plane.totalSeats - soldSet.size;

// So the very first paint (before the client script runs) already carries
// correct aria-labels for a screen reader or keyboard user landing cold.
const initialSaleInfo = initialSeatSaleInfo(
  startDays,
  bookingWindowStartDays,
  plane.totalSeats,
  plane.initialSoldIndices,
  plane.fareBuckets,
);

function seatLabel(idx: number): string {
  const section = sectionForSeat(idx, plane);
  const sale = initialSaleInfo.get(idx);
  if (sale) {
    const soldPrice = priceForSeat(sale.price, section);
    return (
      `Seat ${idx + 1}, ${section.label} (${section.perk}), sold for ` +
      `$${soldPrice}, about ${sale.daysBeforeDeparture} days before departure`
    );
  }
  const price = priceForSeat(initialPrice, section);
  return (
    `Seat ${idx + 1}, ${section.label} (${section.perk}), still available, ` +
    `would cost $${price} now`
  );
}

// Group the flat seat-layout entries into per-section runs for rendering, so
// the markup mirrors buildSeatLayout's own section boundaries exactly —
// main.ts's client-side rebuild groups the same way.
interface SectionGroup {
  section: CabinSection;
  cols: number;
  entries: SeatLayoutEntry[];
}
const sectionGroups: SectionGroup[] = [];
for (const entry of buildSeatLayout(plane)) {
  const last = sectionGroups[sectionGroups.length - 1];
  if (last && last.section === entry.section) {
    last.entries.push(entry);
  } else {
    sectionGroups.push({
      section: entry.section,
      cols: entry.section.columnGroups.reduce((a, b) => a + b, 0),
      entries: [entry],
    });
  }
}
---

<Layout title="Should you book now, or wait? — a live flight-price explainer">
  <nav aria-label="Skip">
    <a href="#controls" class="skip-link">Skip to booking controls</a>
  </nav>
  <main>
    <h1>Should you book this flight now, or wait?</h1>
    <p data-testid="intro">
      Airline fares don't drift — they climb in fixed steps, and once a step
      is taken it never gives ground back. Below is one flight, watched live:
      seats sell in the background as you read, each one pushing the price up
      to its next bracket. Click <strong>Wait</strong> to let more time (and
      more buyers) pass, or <strong>Book now</strong> to lock in today's
      price.
    </p>

    <div class="plane-picker">
      <label for="plane-select">Aircraft to simulate</label>
      <select id="plane-select" data-testid="plane-select">
        {
          PLANE_TYPES.map((p) => (
            <option value={p.id} selected={p.id === plane.id}>
              {p.label}
            </option>
          ))
        }
      </select>
      <p class="plane-note" data-testid="plane-note">
        {plane.note}
      </p>
    </div>

    <section class="flight-status" aria-label="Flight status">
      <dl>
        <div>
          <dt>Flight</dt>
          <dd data-testid="flight-number">
            {plane.flightNumber} {plane.route}
          </dd>
        </div>
        <div>
          <dt>Days to departure</dt>
          <dd data-testid="days-remaining">{startDays}</dd>
        </div>
        <div>
          <dt>Seats remaining</dt>
          <dd data-testid="seats-remaining">{seatsRemaining}</dd>
        </div>
        <div>
          <dt>Current price</dt>
          <dd data-testid="price" class="price">${initialPrice}</dd>
        </div>
      </dl>
    </section>

    <div
      class="seat-map"
      data-testid="seat-map"
      data-plane={plane.id}
      aria-label="Seat map"
    >
      {
        sectionGroups.map((group) => (
          <div class="cabin-section">
            <h2 class="cabin-heading">{group.section.label}</h2>
            <div class="cabin-grid" style={`--cols: ${group.cols}`}>
              {group.entries.map((entry) => (
                <button
                  type="button"
                  class="seat"
                  data-index={entry.index}
                  data-status={soldSet.has(entry.index) ? "sold" : "available"}
                  data-aisle-after={entry.aisleAfter ? "true" : undefined}
                  aria-label={seatLabel(entry.index)}
                  tabindex={entry.index === 0 ? 0 : -1}
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="seat-legend" aria-hidden="true">
      <span class="legend-item">
        <span class="legend-dot" data-status="sold"></span>Sold
      </span>
      <span class="legend-item">
        <span class="legend-dot" data-status="available"></span>Available
      </span>
    </div>

    <p class="seat-info" data-testid="seat-info" aria-live="polite" hidden>
    </p>

    <p class="visually-hidden" aria-live="polite" data-testid="sr-summary">
      {soldSet.size} of {plane.totalSeats} seats sold. Current price ${
        initialPrice
      }. {startDays} days to departure.
    </p>

    <div class="controls" id="controls">
      <button type="button" data-testid="wait-button">Wait</button>
      <button type="button" data-testid="book-button">Book now</button>
      <button type="button" class="reset-button" data-testid="reset-button">
        Reset
      </button>
    </div>

    <div class="result" data-testid="result" hidden>
      <div data-testid="result-text"></div>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
