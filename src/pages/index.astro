---
import Layout from "../layouts/Layout.astro";
import {
  PLANE_TYPES,
  initialSeatSaleInfo,
  priceForFlight,
} from "../scripts/price";

const plane = PLANE_TYPES[0];
const soldSet = new Set(plane.initialSoldIndices);
const startDays = 60;
const bookingWindowStartDays = 120;
const initialPrice = priceForFlight(soldSet.size, plane, startDays).price;
const seatsRemaining = plane.totalSeats - soldSet.size;

// So the very first paint (before the client script runs) already carries
// correct aria-labels for a screen reader or keyboard user landing cold.
const initialSaleInfo = initialSeatSaleInfo(
  startDays,
  bookingWindowStartDays,
  plane.totalSeats,
  plane.initialSoldIndices,
);

const seats = Array.from({ length: plane.totalSeats }, (_, i) => {
  const sale = initialSaleInfo.get(i);
  const label = sale
    ? `Seat ${i + 1}, sold in the $${sale.price} fare bracket, about ${sale.daysBeforeDeparture} days before departure`
    : `Seat ${i + 1}, still available, would cost $${initialPrice} now`;
  return { index: i, sold: soldSet.has(i), label };
});
---

<Layout title="Wait, and the price goes up — a flight-price explainer">
  <header>
    <p class="top-bar">LIVE FLIGHT &middot; QF738 CBR&rarr;SYD</p>
    <nav aria-label="Primary">
      <a href="./" class="home-link">Home</a>
    </nav>
  </header>
  <main>
    <h1>Wait, and the price goes up</h1>
    <p data-testid="intro">
      This is one flight, watched live. Seats sell in the background as you
      read — other buyers, acting in real time. Every seat that goes marks
      the flight up to its next price bracket. Click <strong>Wait</strong> to
      let more time (and more buyers) pass, or <strong>Book now</strong> to
      lock in today's price.
    </p>

    <div class="plane-picker">
      <label for="plane-select">Aircraft to simulate</label>
      <select id="plane-select" data-testid="plane-select">
        {
          PLANE_TYPES.map((p) => (
            <option value={p.id} selected={p.id === plane.id}>
              {p.label}
            </option>
          ))
        }
      </select>
      <p class="plane-note">
        Wide-body long-haul demand is driven by discretionary leisure travel
        — far less predictable than the regional and narrow-body routes
        here. If a wide-body flight is still badly under-booked close to
        departure, the airline may drop the price again rather than fly it
        nearly empty; that risk doesn't apply to the other two aircraft.
      </p>
    </div>

    <section class="flight-status" aria-label="Flight status">
      <dl>
        <div>
          <dt>Flight</dt>
          <dd>QF738 CBR&rarr;SYD</dd>
        </div>
        <div>
          <dt>Days to departure</dt>
          <dd data-testid="days-remaining">{startDays}</dd>
        </div>
        <div>
          <dt>Seats remaining</dt>
          <dd data-testid="seats-remaining">{seatsRemaining}</dd>
        </div>
        <div>
          <dt>Current price</dt>
          <dd data-testid="price" class="price">${initialPrice}</dd>
        </div>
      </dl>
    </section>

    <div
      class="seat-map"
      data-testid="seat-map"
      data-cols={plane.columns}
      style={`--seat-cols: ${plane.columns}`}
      aria-label="Seat map"
    >
      {
        seats.map((seat) => (
          <button
            type="button"
            class="seat"
            data-index={seat.index}
            data-status={seat.sold ? "sold" : "available"}
            aria-label={seat.label}
            tabindex={seat.index === 0 ? 0 : -1}
          />
        ))
      }
    </div>

    <div class="seat-legend" aria-hidden="true">
      <span class="legend-item">
        <span class="legend-dot" data-status="sold"></span>Sold
      </span>
      <span class="legend-item">
        <span class="legend-dot" data-status="available"></span>Available
      </span>
    </div>

    <p class="seat-info" data-testid="seat-info" aria-live="polite" hidden>
    </p>

    <p class="visually-hidden" aria-live="polite" data-testid="sr-summary">
      {soldSet.size} of {plane.totalSeats} seats sold. Current price ${
        initialPrice
      }. {startDays} days to departure.
    </p>

    <div class="controls">
      <button type="button" data-testid="wait-button">Wait</button>
      <button type="button" data-testid="book-button">Book now</button>
      <button type="button" class="reset-button" data-testid="reset-button">
        Reset
      </button>
    </div>

    <div class="result" data-testid="result" hidden>
      <div data-testid="result-text"></div>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
